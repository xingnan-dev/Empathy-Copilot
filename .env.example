# REQUIRED — local processes use localhost; Compose overrides the hostname for backend.
DATABASE_URL=postgresql+psycopg://empathy:change-me@localhost:5432/empathy_copilot

# TEST-ONLY — must name an isolated database containing "test".
TEST_DATABASE_URL=postgresql+psycopg://empathy:change-me@localhost:5432/empathy_copilot_test

# REQUIRED for real language generation. Leave the key empty for deterministic fallbacks.
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OPTIONAL — uses LLM_API_KEY and LLM_BASE_URL when configured.
VISION_PROVIDER=qwen
VISION_MODEL=qwen3.7-plus

# OPTIONAL official workbook. Local example: C:\path\official.xlsx
# Compose example after copying the workbook to competition_data/official.xlsx:
# OFFICIAL_DATASET_PATH=/competition-data/official.xlsx
OFFICIAL_DATASET_PATH=

# FRONTEND-ONLY build configuration.
VITE_API_BASE_URL=http://localhost:8000
